diff --git a/sdk/examples/whoami.c b/sdk/examples/whoami.c
new file mode 100644
index 0000000..a9a39c9
--- /dev/null
+++ b/sdk/examples/whoami.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Phoenix-8086 SDK example — whoami (solution to lab 1)
+ *
+ * Asks the kernel for this thread's ID and prints it.
+ */
+
+#include "phoenix.h"
+
+int main(void)
+{
+    unsigned tid = px_gettid();
+
+    px_puts("I am thread ");
+    if (tid >= 10) {
+        px_putc('0' + tid / 10);
+    }
+    px_putc('0' + tid % 10);
+    px_putc('\n');
+    return 0;
+}
